#!/bin/sh
# build-anywhere: compile C on any POSIX system, with no dependencies.
# https://github.com/v3ai/build-anywhere
#
# Usage:
#   build-anywhere [OPTIONS] [CC-FLAGS] FILE.c... [-o OUTPUT]
#   build-anywhere --cc        print a working C compiler command (getting one if needed)
#   build-anywhere --doctor    report which ways of getting a compiler work here
#
# A C compiler is found by trying these tiers in order; the first one that
# compiles and runs a test program wins:
#
#   system     a compiler that is already installed (cc, c99, gcc, clang, tcc, ...)
#   download   a pinned, SHA-256-verified Zig toolchain, used as `zig cc`
#   bootstrap  TCC built from source starting from nothing but this shell, using
#              the pnut C-to-shell compiler (x86 and x86_64 Linux)
#   shell      the program itself compiled to a POSIX shell script by pnut
#              (runs anywhere, but only accepts a subset of C)
#
# Options:
#   --tiers=LIST   comma-separated tiers to try, in order
#                  (default: system,download,bootstrap,shell)
#   --cache=DIR    where acquired compilers are kept
#                  (default: ${XDG_CACHE_HOME:-$HOME/.cache}/build-anywhere)
#   -v, --verbose  show each probe and command
#   -h, --help     show this help
#   --version      show the version
#
# Every other argument is passed to the compiler unchanged.
#
# Environment: CC (tried first), BA_TIERS, BA_CACHE, BA_SHELL (shell used to run
# pnut; default: the fastest one installed), BA_VERBOSE=1.

BA_VERSION=0.1.0

