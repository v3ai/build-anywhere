# ---------------------------------------------------------------------------
# Utilities

set -u
umask 022

say()  { printf 'build-anywhere: %s\n' "$*" >&2; }
vsay() { [ "$BA_VERBOSE" = 1 ] && say "$*"; return 0; }
die()  { say "error: $*"; exit 1; }

# Quote $1 for safe reuse with eval or in a generated script.
q() {
    case $1 in
    *\'*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *)    printf "'%s'" "$1" ;;
    esac
}

have() { command -v "$1" >/dev/null 2>&1; }

ba_abspath() {
    case $1 in
    /*) printf '%s\n' "$1" ;;
    *)  printf '%s/%s\n' "$(pwd)" "$1" ;;
    esac
}

# Directory holding this script (and seed/, libc/).
BA_SELF=$0
case $BA_SELF in */*) ;; *) BA_SELF=$(command -v -- "$BA_SELF" 2>/dev/null || printf '%s' "$BA_SELF") ;; esac
BA_HOME=$(cd "$(dirname -- "$BA_SELF")" && pwd) || die "cannot locate the build-anywhere directory"
BA_SEED=$BA_HOME/seed

ba_os() {
    case $(uname -s 2>/dev/null) in
    Linux)     echo linux ;;
    Darwin)    echo macos ;;
    FreeBSD)   echo freebsd ;;
    NetBSD)    echo netbsd ;;
    OpenBSD)   echo openbsd ;;
    DragonFly) echo dragonfly ;;
    SunOS)     echo solaris ;;
    AIX)       echo aix ;;
    Haiku)     echo haiku ;;
    *)         uname -s 2>/dev/null | sed 'y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/' ;;
    esac
}

ba_arch() {
    ba_m=$(uname -m 2>/dev/null)
    # macOS reports the hardware arch of the running process; ask for the
    # real hardware so that an x86_64 shell under Rosetta still gets arm64.
    if [ "$(uname -s 2>/dev/null)" = Darwin ] &&
       [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then
        ba_m=arm64
    fi
    # A 32-bit user space on a 64-bit Linux kernel (a 32-bit container, for
    # example) needs 32-bit tools: byte 5 of an ELF file is 1 for 32-bit.
    if [ "$(uname -s 2>/dev/null)" = Linux ]; then
        case $ba_m in
        x86_64|aarch64)
            # shellcheck disable=SC2046
            set -- $(od -An -tu1 -j4 -N1 /bin/sh 2>/dev/null) 0
            if [ "$1" = 1 ]; then
                case $ba_m in x86_64) ba_m=i686 ;; aarch64) ba_m=armv7l ;; esac
            fi ;;
        esac
    fi
    case $ba_m in
    x86_64|amd64)             echo x86_64 ;;
    i[3456]86|i86pc|x86)      echo x86 ;;
    aarch64|arm64|evbarm64)   echo aarch64 ;;
    arm*|evbarm)              echo arm ;;
    riscv64)                  echo riscv64 ;;
    ppc64le|powerpc64le)      echo powerpc64le ;;
    s390x)                    echo s390x ;;
    loongarch64)              echo loongarch64 ;;
    *)                        echo "$ba_m" ;;
    esac
}

# ---------------------------------------------------------------------------
# Probing a compiler: it must compile a small C89 program that uses the
# standard library, and the result must run.

ba_write_probe() {
    # Every C89 header: a compiler whose system headers are incomplete
    # (gcc without the kernel headers, say) fails here, not later.
    cat >"$BA_TMP/probe.c" <<'EOF'
#include <assert.h>
#include <ctype.h>
#include <errno.h>
#include <float.h>
#include <limits.h>
#include <locale.h>
#include <math.h>
#include <setjmp.h>
#include <signal.h>
#include <stdarg.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

char buf[16]; /* global: pnut's shell backend has no local arrays */

int main(void)
{
    strcpy(buf, "probe");
    strcat(buf, "-ok");
    printf("%s %d\n", buf, (int)strlen(buf));
    return EXIT_SUCCESS;
}
EOF
}

# probe_cc QUOTED-COMMAND -> success if it builds a working program.
probe_cc() {
    rm -f "$BA_TMP/probe" "$BA_TMP/probe.out"
    vsay "probing: $1"
    if ! eval "$1 -o \"\$BA_TMP/probe\" \"\$BA_TMP/probe.c\"" >>"$BA_TMP/log" 2>&1; then
        vsay "  does not compile"
        return 1
    fi
    if ! "$BA_TMP/probe" >"$BA_TMP/probe.out" 2>>"$BA_TMP/log"; then
        vsay "  output does not run"
        return 1
    fi
    if [ "$(cat "$BA_TMP/probe.out")" != "probe-ok 8" ]; then
        vsay "  output prints the wrong thing"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Tier 1: a compiler that is already installed.

# Print the versioned compilers (gcc-14, clang-19, FreeBSD's gcc13, ...)
# in DIR whose names start with NAME (gcc or clang), skipping gcc-ar-14,
# gcc13-ar and the like.
versioned_cc() { # DIR NAME
    for vc_f in "$1/$2"-[0-9]* "$1/$2"[0-9]*; do
        case ${vc_f##*/} in *-*-*|"$2"[0-9]*-*) continue ;; esac
        [ -x "$vc_f" ] && printf '%s\n' "$vc_f"
    done
    return 0
}

# The names of the versioned compilers called NAME in PATH.
path_versioned_cc() { # NAME
    pv_ifs=$IFS; IFS=:
    for pv_d in $PATH; do
        IFS=$pv_ifs
        versioned_cc "$pv_d" "$1" | sed 's|.*/||'
    done
    IFS=$pv_ifs
}

# search_cc DESCRIPTION PREFER [DIR...]: probe $CC, the compilers in each
# DIR, then the usual compiler names in PATH, and set BA_CC and BA_CC_DESC
# to the first that works. PREFER (gcc, clang or empty) is tried before
# the other names, so that a compiler that was just installed wins over
# an older one.
search_cc() {
    ts_desc=$1 ts_prefer=$2
    shift 2
    ts_cands=
    [ -n "${CC:-}" ] && ts_cands=$CC
    ts_names="cc gcc clang"
    [ -n "$ts_prefer" ] && ts_names="$ts_prefer $ts_names"
    for ts_dir in ${1+"$@"}; do   # (old ksh: "$@" with no arguments is an error under set -u)
        for ts_n in $ts_names; do
            [ -x "$ts_dir/$ts_n" ] && ts_cands="$ts_cands
$(q "$ts_dir/$ts_n")"
        done
        ts_vs=$(versioned_cc "$ts_dir" gcc; versioned_cc "$ts_dir" clang)
        ts_ifs=$IFS
        IFS='
'
        for ts_f in $ts_vs; do
            ts_cands="$ts_cands
$(q "$ts_f")"
        done
        IFS=$ts_ifs
    done
    for ts_n in $ts_prefer cc c99 gcc clang tcc c89 pcc cproc icx suncc; do
        ts_cands="$ts_cands
$ts_n"
        if [ "$ts_n" = "$ts_prefer" ]; then
            ts_cands="$ts_cands
$(path_versioned_cc "$ts_n")"
        fi
    done
    ts_cands="$ts_cands
$(path_versioned_cc gcc)
$(path_versioned_cc clang)"
    ts_ifs=$IFS

    ts_nl='
'
    IFS=$ts_nl
    for ts_c in $ts_cands; do
        IFS=$ts_ifs
        [ -n "$ts_c" ] || continue
        # $CC may hold flags ("gcc -m32"); only its first word must exist.
        eval "set -- $ts_c"
        have "$1" || continue
        ts_path=$(command -v "$1")
        # On macOS the /usr/bin compilers are stubs that open an installer
        # dialog when the Command Line Tools are missing.
        if [ "$BA_OS" = macos ] && [ "${ts_path%/*}" = /usr/bin ] &&
           ! xcode-select -p >/dev/null 2>&1; then
            vsay "skipping $ts_path: Xcode Command Line Tools are not installed"
            continue
        fi
        if probe_cc "$ts_c"; then
            BA_CC=$ts_c
            BA_CC_DESC="$ts_desc '$*'"
            return 0
        fi
    done
    IFS=$ts_ifs
    return 1
}

tier_system() {
    search_cc "system compiler" ""
}

# ---------------------------------------------------------------------------
# Tier 2: install a compiler with the package manager.

# Decide how to run commands as root. Sets PKG_SUDO (empty when already
# root) and PKG_HOW. Fails when that would need a password and there is no
# terminal to ask on, or when BA_SUDO=never.
pkg_privilege() {
    PKG_SUDO=
    PKG_HOW="as root"
    [ "$(id -u 2>/dev/null)" = 0 ] && return 0
    [ "${BA_SUDO:-auto}" = never ] && return 1
    if have sudo && sudo -n true >/dev/null 2>&1; then
        PKG_SUDO="sudo -n"; PKG_HOW="with sudo"; return 0
    fi
    if have doas && doas -n true >/dev/null 2>&1; then
        PKG_SUDO="doas -n"; PKG_HOW="with doas"; return 0
    fi
    if [ -t 0 ] && [ -t 2 ]; then
        for pp_s in sudo doas; do
            if have "$pp_s"; then
                PKG_SUDO=$pp_s
                PKG_HOW="with $pp_s (it may ask for your password)"
                return 0
            fi
        done
    fi
    return 1
}

# pkg_managers [root]: print the package managers that can be used here,
# best first. Those that need root are printed only with the argument
# "root" (pass it when pkg_privilege succeeded).
pkg_managers() {
    if [ "${1:-}" = root ]; then
        # (On Photon OS, yum is a front end to tdnf.)
        for pm in apt-get dnf tdnf yum microdnf zypper apk pacman xbps-install; do
            have "$pm" && echo "$pm"
        done
        [ "$BA_OS" = freebsd ] && have pkg && echo pkg
        # The Command Line Tools: clang, headers and the linker.
        [ "$BA_OS" = macos ] && have softwareupdate && ! xcode-select -p >/dev/null 2>&1 &&
            echo softwareupdate
    fi
    # These install without root.
    if [ -n "${TERMUX_VERSION:-}" ] && have pkg; then echo termux; fi
    have brew && [ "$(id -u 2>/dev/null)" != 0 ] && echo brew
    have nix && echo nix
    return 0
}

# The compilers to ask a package manager for, in order.
pkg_compilers() {
    case $1 in
    termux|softwareupdate) echo clang ;;
    *) echo gcc clang ;;
    esac
}

# pkg_run COMMAND...: run as root (as decided by pkg_privilege), logging
# the output. Standard input is closed so that nothing waits for a prompt;
# sudo and doas ask for passwords on the terminal itself.
pkg_run() {
    vsay "+ $PKG_SUDO $*"
    echo "+ $PKG_SUDO $*" >>"$BA_TMP/pkg.out"
    $PKG_SUDO "$@" </dev/null >>"$BA_TMP/pkg.out" 2>&1
}

# The last lines the package manager printed for this install, indented.
pkg_output() {
    [ -f "$BA_TMP/pkg.out" ] || return 0
    sed -e :a -e '$q;N;16,$D;ba' "$BA_TMP/pkg.out" | sed 's/^/    /' >&2
}

# softwareupdate: install the newest Command Line Tools without the
# dialog, the way Homebrew's installer does.
pkg_clt() {
    pc_flag=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    pkg_run touch "$pc_flag" || return 1
    pc_label=$(softwareupdate -l 2>>"$BA_TMP/log" | grep -B 1 -E 'Command Line Tools' |
               awk -F'*' '/^ *\*/ { print $2 }' | sed -e 's/^ *Label: //' -e 's/^ *//' |
               sort -V | tail -n 1)
    pc_ok=1
    if [ -n "$pc_label" ]; then
        pkg_run softwareupdate -i "$pc_label" && pc_ok=0
    else
        vsay "package: softwareupdate offers no Command Line Tools"
    fi
    pkg_run rm -f "$pc_flag"
    return $pc_ok
}

# pkg_install MANAGER COMPILER: install COMPILER (gcc or clang) and what it
# needs to build C programs. On success, print directories outside PATH
# that the compiler may have been installed to.
pkg_install() {
    case $1 in
    apt-get)
        set -- "$2" libc6-dev
        pkg_run env DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "$@" ||
            { pkg_run env DEBIAN_FRONTEND=noninteractive apt-get update -q &&
              pkg_run env DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "$@"; } ;;
    dnf|yum|microdnf)
        pkg_run "$1" install -y "$2" ;;
    tdnf)   # Photon OS, Azure Linux: gcc does not pull in these
        pkg_run tdnf install -y "$2" glibc-devel binutils || return 1
        # <limits.h> needs the kernel's headers, which have different names.
        pkg_run tdnf install -y linux-api-headers || pkg_run tdnf install -y kernel-headers
        return 0 ;;
    zypper)
        pkg_run zypper --non-interactive install --no-recommends "$2" glibc-devel ;;
    apk)
        pkg_run apk add --no-cache "$2" musl-dev ;;
    pacman)
        # Without a package database (a fresh container) it has to sync first.
        pkg_run pacman -S --noconfirm --needed "$2" ||
            pkg_run pacman -Sy --noconfirm --needed "$2" ;;
    xbps-install)
        pkg_run xbps-install -Sy "$2" ||
            { pkg_run xbps-install -Syu xbps && pkg_run xbps-install -Sy "$2"; } ;;
    pkg)
        case $2 in gcc) set -- gcc ;; *) set -- llvm ;; esac
        pkg_run env ASSUME_ALWAYS_YES=yes pkg install -y "$1" ;;
    softwareupdate)
        pkg_clt ;;
    termux)
        pkg_run pkg install -y "$2" ;;
    brew)
        case $2 in gcc) set -- gcc ;; *) set -- llvm ;; esac
        pkg_run env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 \
            HOMEBREW_NO_ENV_HINTS=1 brew install "$1" || return 1
        pi_pre=$(brew --prefix 2>/dev/null) && echo "$pi_pre/bin"
        pi_pre=$(brew --prefix "$1" 2>/dev/null) && echo "$pi_pre/bin"
        return 0 ;;
    nix)
        # This only adds the compiler to the Nix store; nothing else changes.
        vsay "+ nix build nixpkgs#$2"
        pi_out=$(nix --extra-experimental-features 'nix-command flakes' build --no-link \
                 --print-out-paths "nixpkgs#$2" </dev/null 2>>"$BA_TMP/log") || return 1
        printf '%s\n' "$pi_out" | sed 's|$|/bin|'
        return 0 ;;
    *) return 1 ;;
    esac
}

tier_package() {
    tp_root=
    pkg_privilege && tp_root=root
    tp_pms=$(pkg_managers "$tp_root")
    if [ -z "$tp_pms" ]; then
        tp_need=$(pkg_managers root | sed -n 1p)
        if [ -n "$tp_need" ]; then
            say "package: $tp_need could install a compiler, but needs root (run as root, or with sudo or doas)"
        else
            vsay "package: no supported package manager"
        fi
        return 1
    fi
    for tp_pm in $tp_pms; do
        PKG_SUDO_SAVE=$PKG_SUDO
        case $tp_pm in brew|nix|termux) PKG_SUDO= tp_how="(no root needed)" ;; *) tp_how=$PKG_HOW ;; esac
        for tp_c in $(pkg_compilers "$tp_pm"); do
            say "installing $tp_c with $tp_pm $tp_how..."
            : >"$BA_TMP/pkg.out"
            tp_dirs=$(pkg_install "$tp_pm" "$tp_c")
            tp_st=$?
            cat "$BA_TMP/pkg.out" >>"$BA_TMP/log"
            if [ "$tp_st" = 0 ]; then
                # shellcheck disable=SC2086
                if search_cc "$tp_c from $tp_pm:" "$tp_c" $tp_dirs; then
                    return 0
                fi
                say "package: $tp_pm installed $tp_c, but it does not compile and run a test program"
            else
                say "package: $tp_pm could not install $tp_c:"
                pkg_output
            fi
        done
        PKG_SUDO=$PKG_SUDO_SAVE
    done
    return 1
}

# ---------------------------------------------------------------------------
# Tier 3: download a prebuilt toolchain.

# ba_fetch URL FILE
ba_fetch() {
    rm -f "$2"
    if have curl; then
        # Give up on a stalled source (under 1 KB/s for a minute): the next is tried.
        curl -fsSL --retry 2 --connect-timeout 20 -Y 1024 -y 60 -o "$2" "$1" 2>>"$BA_TMP/log" && return 0
    fi
    if have wget; then
        wget -q -T 20 -O "$2" "$1" 2>>"$BA_TMP/log" && return 0
    fi
    if have fetch; then    # FreeBSD
        fetch -q -T 20 -o "$2" "$1" 2>>"$BA_TMP/log" && return 0
    fi
    if [ "$BA_OS" = openbsd ] && have ftp; then
        ftp -V -o "$2" "$1" >>"$BA_TMP/log" 2>&1 && return 0
    fi
    if have busybox; then
        busybox wget -q -O "$2" "$1" 2>>"$BA_TMP/log" && return 0
    fi
    rm -f "$2"
    return 1
}

have_fetcher() {
    have curl || have wget || have fetch || have busybox ||
        { [ "$BA_OS" = openbsd ] && have ftp; }
}

# ba_hash ALGORITHM(sha256|sha512) FILE -> prints the lowercase hex digest.
ba_hash() {
    bh_n=${1#sha}
    bh_len=64
    [ "$bh_n" = 512 ] && bh_len=128
    bh_out=
    if have "sha${bh_n}sum"; then bh_out=$("sha${bh_n}sum" "$2" 2>/dev/null)
    elif have shasum; then bh_out=$(shasum -a "$bh_n" "$2" 2>/dev/null)
    elif have "sha$bh_n"; then bh_out=$("sha$bh_n" -q "$2" 2>/dev/null)
    elif have openssl; then bh_out=$(openssl dgst "-sha$bh_n" -r "$2" 2>/dev/null)
    elif have busybox; then bh_out=$(busybox "sha${bh_n}sum" "$2" 2>/dev/null)
    elif have cksum && cksum -a "sha$bh_n" /dev/null >/dev/null 2>&1; then
        bh_out=$(cksum -a "sha$bh_n" -q "$2" 2>/dev/null) ||
            bh_out=$(cksum -a "sha$bh_n" "$2" 2>/dev/null)
    fi
    bh_out=$(printf '%s\n' "$bh_out" | sed 'y/ABCDEF/abcdef/' |
             sed -n "s/.*\([0-9a-f]\{$bh_len\}\).*/\1/p" | sed -n 1p)
    [ -n "$bh_out" ] || return 1
    printf '%s\n' "$bh_out"
}

have_hash() { # ALGORITHM
    hh_n=${1#sha}
    have "sha${hh_n}sum" || have shasum || have "sha$hh_n" || have openssl ||
        { have busybox && busybox "sha${hh_n}sum" /dev/null >/dev/null 2>&1; } ||
        { have cksum && cksum -a "sha$hh_n" /dev/null >/dev/null 2>&1; }
}

# ba_unpack ARCHIVE DIR: unpack a .tgz or .tar.xz.
ba_unpack() {
    case $1 in
    *.tgz|*.tar.gz)
        if have gzip; then gzip -dc "$1" | (cd "$2" && tar -xf -) && return 0; fi
        if have busybox; then busybox gzip -dc "$1" | (cd "$2" && busybox tar -xf -) && return 0; fi ;;
    *.tar.xz)
        if have xz; then xz -dc "$1" | (cd "$2" && tar -xf -) && return 0; fi
        if have unxz; then unxz -c "$1" | (cd "$2" && tar -xf -) && return 0; fi
        if have xzcat; then xzcat "$1" | (cd "$2" && tar -xf -) && return 0; fi
        (cd "$2" && tar -xJf "$1") 2>>"$BA_TMP/log" && return 0
        if have busybox; then busybox xz -dc "$1" | (cd "$2" && busybox tar -xf -) && return 0; fi ;;
    esac
    return 1
}

have_unpacker() { # FILE
    case $1 in
    *.tgz|*.tar.gz) have gzip || have busybox ;;
    *.tar.xz) have xz || have unxz || have xzcat || have busybox ||
              { have tar && tar --version 2>&1 | grep -q -i -e bsdtar -e libarchive; } ;;
    *) return 1 ;;
    esac
}

# The keys of BA_TOOLCHAINS that fit this machine, best first. A 32-bit
# user space on a 64-bit kernel (a container, for example) can also use a
# 64-bit toolchain that builds 32-bit programs: key "x86/x86_64" or
# "armv7/aarch64".
toolchain_keys() {
    tk_m=$(uname -m 2>/dev/null)
    case $BA_ARCH in
    x86)
        case $tk_m in x86_64|amd64) echo x86/x86_64 ;; esac
        echo x86 ;;
    arm)
        case $tk_m in
        aarch64|arm64|armv8l) echo armv7/aarch64; echo armv7 ;;  # (32-bit user space on arm64)
        armv7*|armv8*) echo armv7 ;;
        armv6*) echo armv6 ;;
        esac ;;
    *) echo "$BA_ARCH" ;;
    esac
}

# Print the BA_TOOLCHAINS lines that fit this machine, best first.
toolchains() {
    [ "$BA_OS" = linux ] || return 0
    for tc_k in $(toolchain_keys); do
        printf '%s\n' "$BA_TOOLCHAINS" | while read -r tc_1 tc_rest; do
            [ "$tc_1" = "$tc_k" ] && printf '%s %s\n' "$tc_1" "$tc_rest"
        done
    done
}

# Free space in kilobytes on the file system holding DIR.
free_kb() {
    # shellcheck disable=SC2046
    set -- $(df -Pk "$1" 2>/dev/null | sed -n 2p)
    [ $# -ge 4 ] && echo "$4"
}

# Write a cc wrapper for an unpacked toolchain: always link statically, as
# its C library (musl) is not installed on the system.
toolchain_wrapper() { # DIR GCC
    mkdir -p "$BA_CACHE/bin" || return 1
    tw=$BA_CACHE/bin/cc-${1##*/toolchain-}
    {
        echo '#!/bin/sh'
        echo '# Generated by build-anywhere: a downloaded gcc that links statically with musl.'
        echo "exec $(q "$1/$2") -static \"\$@\""
    } >"$tw.$$" && chmod 755 "$tw.$$" && mv -f "$tw.$$" "$tw" || return 1
    echo "$tw"
}

# toolchain_get ALGORITHM DIGEST FILE DIRECTORY GCC URL...: download FILE,
# verify it and unpack it as $BA_CACHE/toolchain-DIRECTORY. Call it with the
# download lock held.
toolchain_get() {
    tg_algo=$1 tg_sum=$2 tg_file=$3 tg_top=$4 tg_gcc=$5
    shift 5
    tg_dir=$BA_CACHE/toolchain-$tg_top
    # Unpacked by a process that was interrupted (we hold the lock).
    for tg_old in "$BA_CACHE"/.unpack.*; do
        [ -d "$tg_old" ] && { chmod -R u+w "$tg_old"; rm -rf "$tg_old"; }
    done
    [ -x "$tg_dir/$tg_gcc" ] && return 0    # another process got it meanwhile
    have_fetcher || { vsay "download: no curl, wget, fetch or ftp"; return 1; }
    if ! have_hash "$tg_algo"; then
        say "download: no $tg_algo tool to verify $tg_file with; not downloading it"
        return 1
    fi
    have_unpacker "$tg_file" || { vsay "download: cannot unpack $tg_file"; return 1; }
    tg_free=$(free_kb "$BA_CACHE")
    if [ -n "$tg_free" ] && [ "$tg_free" -lt 1000000 ]; then
        say "download: needs about 1 GB free in $BA_CACHE (only $((tg_free / 1024)) MB)"
        return 1
    fi
    # BA_TEST_URLS replaces the sources ("default" stands for the real
    # ones); the tests use it to check that a corrupted download is rejected.
    if [ -n "${BA_TEST_URLS:-}" ]; then
        tg_urls=
        for tg_u in $BA_TEST_URLS; do
            if [ "$tg_u" = default ]; then tg_urls="$tg_urls $*"; else tg_urls="$tg_urls $tg_u"; fi
        done
        # shellcheck disable=SC2086
        set -- $tg_urls
    fi
    tg_arch=$BA_TMP/$tg_file
    tg_ok=0
    for tg_base in "$@"; do
        say "downloading gcc ($tg_file) from $tg_base..."
        if ! ba_fetch "$tg_base/$tg_file" "$tg_arch"; then
            say "download: could not fetch $tg_base/$tg_file"
            continue
        fi
        tg_got=$(ba_hash "$tg_algo" "$tg_arch") || { say "download: could not hash $tg_file"; break; }
        if [ "$tg_got" = "$tg_sum" ]; then tg_ok=1; break; fi
        say "download: checksum mismatch for $tg_base/$tg_file; not using it"
    done
    if [ "$tg_ok" = 0 ]; then
        rm -f "$tg_arch"
        return 1
    fi
    tg_x=$BA_CACHE/.unpack.$$
    rm -rf "$tg_x"
    mkdir -p "$tg_x" || return 1
    say "unpacking $tg_file..."
    if ba_unpack "$tg_arch" "$tg_x" && [ -x "$tg_x/$tg_top/$tg_gcc" ]; then
        rm -f "$tg_arch"
        # Some archives have read-only directories: they could not be
        # moved, or deleted later with rm -rf.
        chmod -R u+w "$tg_x" &&
            rm -rf "$tg_dir" &&
            mv "$tg_x/$tg_top" "$tg_dir" &&
            rm -rf "$tg_x" &&
            return 0
        say "download: could not install $tg_file in $BA_CACHE"
    else
        say "download: could not unpack $tg_file"
    fi
    chmod -R u+w "$tg_x" 2>/dev/null
    rm -rf "$tg_x" "$tg_arch"
    return 1
}

# toolchain_use DIRECTORY GCC: use an unpacked toolchain if it works here.
toolchain_use() {
    tu_w=$(toolchain_wrapper "$BA_CACHE/toolchain-$1" "$2") || return 1
    if probe_cc "$(q "$tu_w")"; then
        BA_CC=$(q "$tu_w")
        BA_CC_DESC="downloaded gcc ($1)"
        return 0
    fi
    vsay "download: $1 does not work on this system"
    return 1
}

tier_download() {
    td_list=$(toolchains)
    if [ -z "$td_list" ]; then
        vsay "download: no prebuilt toolchain for $BA_ARCH $BA_OS"
        return 1
    fi
    td_nl='
'
    td_ifs=$IFS
    # A toolchain that is already in the cache, then each one in turn.
    for td_pass in cached download; do
        IFS=$td_nl
        for td_line in $td_list; do
            IFS=$td_ifs
            # shellcheck disable=SC2086
            set -- $td_line
            td_top=$5 td_gcc=$6 td_needs=$7
            if [ -x "$BA_CACHE/toolchain-$td_top/$td_gcc" ]; then
                [ "$td_pass" = cached ] && toolchain_use "$td_top" "$td_gcc" && return 0
                continue
            fi
            [ "$td_pass" = download ] || continue
            if [ "$td_needs" != - ] && [ ! -e "$td_needs" ]; then
                vsay "download: $4 needs $td_needs, which this system lacks"
                continue
            fi
            ba_lock download downloading || return 1
            td_algo=$2 td_sum=$3 td_file=$4
            shift 7
            toolchain_get "$td_algo" "$td_sum" "$td_file" "$td_top" "$td_gcc" "$@"
            td_st=$?
            ba_unlock
            [ "$td_st" = 0 ] && toolchain_use "$td_top" "$td_gcc" && return 0
        done
        IFS=$td_ifs
    done
    return 1
}

# ---------------------------------------------------------------------------
# Shells for running pnut: pick the fastest POSIX shell that is installed.
# The public-domain ksh (/bin/ksh on NetBSD; ksh and sh on OpenBSD) cannot
# run pnut: it crashes or hangs. Fails when there is no other shell.
pick_shell() {
    if [ -n "${BA_SHELL:-}" ]; then printf '%s\n' "$BA_SHELL"; return 0; fi
    for ps in dash ksh93 ksh mksh yash bash /bin/sh; do
        have "$ps" || continue
        # Run as sh, it does not set KSH_VERSION: OpenBSD's sh is that ksh.
        case $BA_OS:$ps in openbsd:/bin/sh|openbsd:ksh) continue ;; esac
        ps_v=$("$ps" -c 'echo "${KSH_VERSION:-}"' 2>/dev/null)
        case $ps_v in *"PD KSH"*) continue ;; esac
        command -v "$ps"
        return 0
    done
    return 1
}
NO_SHELL="the only shell is pdksh, which cannot run pnut (install dash or bash, or set BA_SHELL)"

# ---------------------------------------------------------------------------
# Tier 4: bootstrap TCC from the shell.

bootstrap_supported() {
    [ "$BA_OS" = linux ] || return 1
    case $BA_ARCH in x86_64|x86) return 0 ;; esac
    return 1
}

# ba_lock NAME WHAT: one build-anywhere at a time may do WHAT (bootstrapping,
# downloading) in this cache; the others wait.
ba_lock() {
    bl_dir=$BA_CACHE/.$1-lock
    bl_waited=0
    mkdir -p "$BA_CACHE" || return 1
    while ! mkdir "$bl_dir" 2>/dev/null; do
        bl_pid=$(cat "$bl_dir/pid" 2>/dev/null || :)
        if [ -n "$bl_pid" ] && ! kill -0 "$bl_pid" 2>/dev/null; then
            rm -rf "$bl_dir"        # left behind by a process that died
            continue
        fi
        [ "$bl_waited" = 0 ] && say "waiting for another build-anywhere to finish $2..."
        bl_waited=$((bl_waited + 1))
        [ "$bl_waited" -lt 1800 ] || { say "gave up waiting for $bl_dir"; return 1; }
        sleep 1
    done
    echo $$ >"$bl_dir/pid"
    BA_LOCKED=$bl_dir
}
ba_unlock() {
    if [ -n "${BA_LOCKED:-}" ]; then rm -rf "$BA_LOCKED"; fi
    BA_LOCKED=
}

tier_bootstrap() {
    [ -f "$BA_SEED/bootstrap-tcc.sh" ] || { vsay "bootstrap: seed/ is missing"; return 1; }
    bootstrap_supported || {
        vsay "bootstrap: needs x86 or x86_64 Linux (this is $BA_ARCH $BA_OS)"
        return 1
    }
    tb_dir=$BA_CACHE/tcc-$BA_ARCH-linux-$BA_VERSION
    if [ ! -x "$tb_dir/bin/cc" ]; then
        mkdir -p "$BA_CACHE" || return 1
        ba_lock bootstrap bootstrapping || return 1
        if [ ! -x "$tb_dir/bin/cc" ]; then
            tb_sh=$(pick_shell) || { ba_unlock; say "bootstrap: $NO_SHELL"; return 1; }
            if [ -d "$BA_CACHE/work-tcc-$BA_ARCH" ]; then
                say "resuming an interrupted bootstrap of a C compiler from the shell ($tb_sh)"
            else
                say "bootstrapping a C compiler from the shell ($tb_sh); this happens once and takes about 5 minutes"
            fi
            # The work directory survives interruptions: a later run resumes.
            if ! "$tb_sh" "$BA_SEED/bootstrap-tcc.sh" \
                --arch "$BA_ARCH" --shell "$tb_sh" --seed "$BA_SEED" \
                --libc "$BA_HOME/libc" --out "$tb_dir" --work "$BA_CACHE/work-tcc-$BA_ARCH"
            then
                ba_unlock
                say "bootstrap failed (see the output above)"
                return 1
            fi
            rm -rf "$BA_CACHE/work-tcc-$BA_ARCH"
        fi
        ba_unlock
    fi
    if probe_cc "$(q "$tb_dir/bin/cc")"; then
        BA_CC=$(q "$tb_dir/bin/cc")
        BA_CC_DESC="TCC bootstrapped from the shell"
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# Tier 5: compile the program to a shell script with pnut.

tier_shell() {
    [ -f "$BA_SEED/pnut-sh.sh" ] || { vsay "shell: seed/ is missing"; return 1; }
    tsh_sh=$(pick_shell) || { say "shell: $NO_SHELL"; return 1; }
    mkdir -p "$BA_CACHE/bin" || return 1
    tsh_w=$BA_CACHE/bin/cc-pnut
    {
        echo '#!/bin/sh'
        echo '# Generated by build-anywhere: a cc-like front end for pnut-sh.sh.'
        echo "BA_SHELL=\${BA_SHELL:-$(q "$tsh_sh")}"
        echo 'export BA_SHELL'
        echo "exec \"\$BA_SHELL\" $(q "$BA_SEED/cc-pnut.sh") \"\$@\""
    } >"$tsh_w.tmp" && chmod 755 "$tsh_w.tmp" && mv -f "$tsh_w.tmp" "$tsh_w" || return 1
    if probe_cc "$(q "$tsh_w")"; then
        BA_CC=$(q "$tsh_w")
        BA_CC_DESC="pnut (program compiled to a POSIX shell script)"
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------

acquire_cc() {
    ba_write_probe
    ac_ifs=$IFS; IFS=,
    for ac_t in $BA_TIERS; do
        IFS=$ac_ifs
        case $ac_t in
        system|package|download|bootstrap|shell) ;;
        *) die "unknown tier '$ac_t' (expected system, package, download, bootstrap or shell)" ;;
        esac
        vsay "trying tier: $ac_t"
        if tier_$ac_t; then
            vsay "using $BA_CC_DESC"
            return 0
        fi
    done
    IFS=$ac_ifs
    return 1
}

doctor() {
    ba_write_probe
    printf 'build-anywhere %s on %s %s\n' "$BA_VERSION" "$BA_ARCH" "$BA_OS"
    printf 'cache: %s\n\n' "$BA_CACHE"

    printf 'system:    '
    if tier_system; then printf 'ok (%s)\n' "$BA_CC"; else printf 'no working compiler installed\n'; fi

    printf 'package:   '
    dr=
    pkg_privilege && dr=root
    # shellcheck disable=SC2046
    dpm=$(echo $(pkg_managers "$dr"))
    if [ -n "$dpm" ]; then
        printf 'possible (gcc or clang with %s' "$dpm"
        case $dpm in *brew*|*nix*) ;; *) printf ', %s' "$PKG_HOW" ;; esac
        printf ')\n'
    elif [ -n "$(pkg_managers root)" ]; then
        printf 'unavailable (%s needs root: run as root, or allow sudo/doas)\n' "$(pkg_managers root | sed -n 1p)"
    else
        printf 'unavailable (no supported package manager)\n'
    fi

    printf 'download:  '
    dl=$(toolchains)
    dc=$(printf '%s\n' "$dl" | while read -r d1 d2 d3 d4 d5 d6 drest; do
             [ -n "$d5" ] && [ -x "$BA_CACHE/toolchain-$d5/$d6" ] && { echo "$d5"; break; }
         done)
    if [ -z "$dl" ]; then printf 'unavailable (no prebuilt toolchain for %s %s)\n' "$BA_ARCH" "$BA_OS"
    elif [ -n "$dc" ]; then printf 'ok (%s already downloaded)\n' "$dc"
    else
        # shellcheck disable=SC2086
        set -- $dl
        dm=
        have_fetcher || dm="$dm no downloader (curl/wget/fetch/ftp);"
        have_hash "$2" || dm="$dm no $2 tool;"
        have_unpacker "$4" || dm="$dm cannot unpack $4;"
        if [ -z "$dm" ]; then printf 'possible (gcc %s, 40-90 MB, needs network)\n' "$5"
        else printf 'unavailable:%s\n' "${dm%;}"; fi
    fi

    printf 'bootstrap: '
    if [ ! -f "$BA_SEED/bootstrap-tcc.sh" ]; then printf 'unavailable (seed/ is missing)\n'
    elif ! bootstrap_supported; then printf 'unavailable (needs x86 or x86_64 Linux)\n'
    elif [ -x "$BA_CACHE/tcc-$BA_ARCH-linux-$BA_VERSION/bin/cc" ]; then printf 'ok (already bootstrapped)\n'
    elif ! ds=$(pick_shell); then printf 'unavailable (%s)\n' "$NO_SHELL"
    else printf 'possible (one-time build, several minutes, using %s)\n' "$ds"; fi

    printf 'shell:     '
    if [ ! -f "$BA_SEED/pnut-sh.sh" ]; then printf 'unavailable (seed/ is missing)\n'
    elif ! ds=$(pick_shell); then printf 'unavailable (%s)\n' "$NO_SHELL"
    else printf 'possible (C subset only, using %s)\n' "$ds"; fi
}

usage() {
    sed -n '2,/^$/s/^# \{0,1\}//p' "$BA_SELF"
}

# ---------------------------------------------------------------------------
# Main

BA_VERBOSE=${BA_VERBOSE:-0}
BA_TIERS=${BA_TIERS:-system,package,download,bootstrap,shell}
BA_CACHE=${BA_CACHE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/build-anywhere}
BA_MODE=build
BA_ARGS=
BA_NSRC=0

while [ $# -gt 0 ]; do
    case $1 in
    --tiers=*)   BA_TIERS=${1#--tiers=} ;;
    --tiers)     [ $# -ge 2 ] || die "--tiers needs a value"; BA_TIERS=$2; shift ;;
    --cache=*)   BA_CACHE=${1#--cache=} ;;
    --cache)     [ $# -ge 2 ] || die "--cache needs a value"; BA_CACHE=$2; shift ;;
    --cc)        BA_MODE=cc ;;
    --doctor)    BA_MODE=doctor ;;
    -v|--verbose) BA_VERBOSE=1 ;;
    -h|--help)   usage; exit 0 ;;
    --version)   echo "build-anywhere $BA_VERSION"; exit 0 ;;
    *)
        case $1 in *.c|*.C) BA_NSRC=$((BA_NSRC + 1)) ;; esac
        BA_ARGS="$BA_ARGS $(q "$1")"
        ;;
    esac
    shift
done

BA_CACHE=$(ba_abspath "$BA_CACHE")
BA_OS=$(ba_os)
BA_ARCH=$(ba_arch)

BA_TMP=${TMPDIR:-/tmp}/build-anywhere.$$
rm -rf "$BA_TMP"
(umask 077 && mkdir "$BA_TMP") || die "cannot create $BA_TMP"
BA_LOCKED=
trap 'rm -rf "$BA_TMP"; ba_unlock' EXIT
trap 'rm -rf "$BA_TMP"; ba_unlock; exit 130' INT TERM
: >"$BA_TMP/log"

case $BA_MODE in
doctor)
    doctor
    exit 0
    ;;
cc)
    acquire_cc || { cat "$BA_TMP/log" >&2; die "no way to get a C compiler worked (tiers: $BA_TIERS)"; }
    eval "set -- $BA_CC"
    printf '%s\n' "$*"
    exit 0
    ;;
esac

[ -n "$BA_ARGS" ] || { usage >&2; exit 2; }
[ "$BA_NSRC" -gt 0 ] || die "no .c files given"

if ! acquire_cc; then
    say "no way to get a C compiler worked (tiers: $BA_TIERS)"
    say "details:"
    cat "$BA_TMP/log" >&2
    say "run '$0 --doctor' to see what is available on this machine"
    exit 1
fi
say "compiling with $BA_CC_DESC"
vsay "+ $BA_CC$BA_ARGS"
eval "$BA_CC$BA_ARGS"
